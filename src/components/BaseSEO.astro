---
interface Offer {
  name: string;
  description: string;
  price: number;
  unit?: 'MON';
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  offers?: Offer[];
}

const {
  title = "Krause IT — Websites, Hosting & Domains for Small Businesses",
  description = "Website design, hosting and domain management for small businesses, sole traders and community groups. Clear starting prices, fully remote, Australia-wide.",
  ogImage = "/KrauseIT_Social.png",
  noindex = false,
  offers = []
} = Astro.props;

const siteURL = new URL("/", Astro.site).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteURL}#website`,
      url: siteURL,
      name: "Krause IT",
      inLanguage: "en-AU",
      publisher: { "@id": `${siteURL}#organization` }
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteURL}#organization`,
      name: "Krause IT",
      url: siteURL,
      logo: new URL("/icon-512.png", Astro.site).toString(),
      image: ogImageURL.toString(),
      email: "hello@krauseit.com.au",
      taxID: "39 314 549 627",
      description,
      founder: {
        "@type": "Person",
        name: "Ethan Krause",
        jobTitle: "Web Developer & Systems Administrator"
      },
      areaServed: { "@type": "Country", name: "Australia" },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Perth",
        addressRegion: "WA",
        addressCountry: "AU"
      },
      serviceType: [
        "Website design",
        "Website development",
        "Web hosting",
        "Domain management",
        "Website maintenance",
        "Custom WordPress plugin development",
        "IT consulting"
      ],
      ...(offers.length > 0 && {
        hasOfferCatalog: {
          "@type": "OfferCatalog",
          name: "Website packages",
          itemListElement: offers.map((offer) => ({
            "@type": "Offer",
            itemOffered: { "@type": "Service", name: offer.name, description: offer.description },
            priceSpecification: {
              "@type": offer.unit ? "UnitPriceSpecification" : "PriceSpecification",
              minPrice: offer.price,
              priceCurrency: "AUD",
              ...(offer.unit && { unitCode: offer.unit })
            }
          }))
        }
      })
    }
  ]
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex" />}

<!-- Icons -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0b1120" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Krause IT" />
<meta property="og:locale" content="en_AU" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Krause IT — website design, hosting and domains" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content="Krause IT — website design, hosting and domains" />

<!-- Sitemap Link -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Structured Data -->
{!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
