---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Krause IT — Strategic IT Consulting & Infrastructure Change",
  description = "Perth-based IT consultancy delivering complex systems, network, and infrastructure change for schools and businesses across Australia.",
  ogImage = "/KrauseIT_Social.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Krause IT",
  url: new URL("/", Astro.site).toString(),
  logo: new URL("/KrauseIT_Logo_Transparent.png", Astro.site).toString(),
  image: new URL(ogImage, Astro.site).toString(),
  email: "hello@krauseit.com.au",
  description,
  areaServed: [
    {
      "@type": "Country",
      name: "Australia"
    }
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Perth",
    addressRegion: "WA",
    addressCountry: "AU"
  },
  serviceType: [
    "IT consulting",
    "Infrastructure modernisation",
    "Network consulting",
    "Systems migration",
    "Project delivery",
    "Web hosting and design"
  ]
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" href="/KrauseIT_Icon_Transparent.png" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Krause IT — strategic IT consulting and project delivery" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
<meta name="twitter:image:alt" content="Krause IT — strategic IT consulting and project delivery" />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Outfit:wght@100..900&display=swap" />

<!-- Sitemap Link -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
