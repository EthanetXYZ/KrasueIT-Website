---
interface Props {
  eyebrow: string;
  heading: string;
}

const { eyebrow, heading } = Astro.props;
---

<section class="section message-section">
  <div class="container message-container">
    <span class="badge badge-brand">{eyebrow}</span>
    <h1>{heading}</h1>
    <slot />
    <div class="message-actions">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="mailto:hello@krauseit.com.au" class="btn btn-secondary">hello@krauseit.com.au</a>
    </div>
  </div>
</section>

<style>
  .message-section {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .message-container {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-md);
  }

  .message-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }
</style>
