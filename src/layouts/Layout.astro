---
import BaseSEO from '../components/BaseSEO.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseSEO title={title} description={description} />
    <style>
      /* Layout specific styles */
      header {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border);
        transition: background-color var(--transition-fast);
      }

      .header-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 5rem;
      }

      .logo {
        display: flex;
        align-items: center;
      }

      .header-logo-img {
        height: 2.25rem;
        width: auto;
        display: block;
      }

      /* Navigation Menu */
      nav {
        display: flex;
        align-items: center;
        gap: 2rem;
      }

      .nav-links {
        display: flex;
        list-style: none;
        gap: 2rem;
      }

      .nav-link {
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--color-text-muted);
        position: relative;
        padding: 0.25rem 0;
      }

      .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background-color: var(--color-brand);
        transition: width var(--transition-normal);
      }

      .nav-link:hover {
        color: var(--color-text-main);
      }

      .nav-link:hover::after {
        width: 100%;
      }

      .header-cta {
        display: none;
      }

      .header-cta-mobile,
      .nav-overlay {
        display: none;
      }

      /* Mobile Menu Toggle */
      .nav-toggle-button {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0.8rem 0.65rem;
        border: 0;
        border-radius: var(--radius-sm);
        background: transparent;
        cursor: pointer;
        z-index: 110;
      }

      .nav-toggle-button span {
        display: block;
        height: 2px;
        width: 100%;
        background-color: var(--color-text-main);
        border-radius: 9px;
        transition: transform var(--transition-normal), opacity var(--transition-normal);
      }

      @media (min-width: 768px) {
        .nav-toggle-button {
          display: none;
        }

        .header-cta {
          display: inline-flex;
          padding: 0.6rem 1.25rem;
          font-size: 0.9rem;
        }
      }

      @media (max-width: 767px) {
        nav {
          position: fixed;
          top: 0;
          right: -100%;
          width: 80%;
          max-width: 320px;
          height: 100vh;
          background-color: var(--color-bg-main);
          box-shadow: var(--shadow-xl);
          flex-direction: column;
          align-items: flex-start;
          justify-content: flex-start;
          padding: 7rem 2rem var(--spacing-lg);
          gap: 3rem;
          transition: right var(--transition-normal);
          z-index: 105;
          border-left: 1px solid var(--color-border);
        }

        .nav-links {
          flex-direction: column;
          width: 100%;
          gap: 1.75rem;
        }

        .nav-link {
          font-size: 1.2rem;
          display: block;
          width: 100%;
        }

        /* Toggle Menu State */
        body.nav-open {
          overflow: hidden;
        }

        body.nav-open nav {
          right: 0;
        }

        .nav-toggle-button[aria-expanded="true"] span:nth-child(1) {
          transform: translateY(7px) rotate(45deg);
        }

        .nav-toggle-button[aria-expanded="true"] span:nth-child(2) {
          opacity: 0;
        }

        .nav-toggle-button[aria-expanded="true"] span:nth-child(3) {
          transform: translateY(-7px) rotate(-45deg);
        }

        /* Overlay blur background */
        .nav-overlay {
          display: none;
          position: fixed;
          inset: 0;
          width: 100vw;
          height: 100vh;
          border: 0;
          background-color: rgba(15, 23, 42, 0.3);
          backdrop-filter: blur(4px);
          cursor: pointer;
          z-index: 102;
        }

        body.nav-open .nav-overlay {
          display: block;
        }

        .header-cta-mobile {
          display: inline-flex;
          width: 100%;
          margin-top: var(--spacing-sm);
        }
      }

      /* Footer Styling */
      footer {
        background-color: var(--color-bg-dark);
        color: var(--color-text-light);
        padding-top: var(--spacing-xl);
        padding-bottom: var(--spacing-lg);
        border-top: 1px solid var(--color-border-dark);
      }

      .footer-top {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-xl);
      }

      @media (min-width: 768px) {
        .footer-top {
          flex-direction: row;
          justify-content: space-between;
          align-items: flex-start;
        }
      }

      .footer-brand {
        max-width: 320px;
      }

      .footer-logo {
        display: flex;
        align-items: center;
        margin-bottom: var(--spacing-sm);
      }

      .footer-logo-img {
        height: 2.25rem;
        width: auto;
        display: block;
        filter: brightness(0) invert(1);
      }

      .footer-brand p {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.95rem;
      }

      .footer-links {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-lg);
      }

      @media (min-width: 768px) {
        .footer-links {
          gap: var(--spacing-xl);
        }
      }

      .footer-link-group h4 {
        color: var(--color-text-light);
        font-family: var(--font-display);
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: var(--spacing-sm);
      }

      .footer-link-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
      }

      .footer-link {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.6);
      }

      .footer-link:hover {
        color: var(--color-text-light);
      }

      .footer-bottom {
        border-top: 1px solid var(--color-border-dark);
        padding-top: var(--spacing-md);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.4);
      }

      @media (min-width: 768px) {
        .footer-bottom {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
        }
      }

      .footer-geo {
        font-style: normal;
        color: rgba(255, 255, 255, 0.5);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header>
      <div class="container header-container">
        <a href="/" class="logo" aria-label="Krause IT home page">
          <img src="/KrauseIT_Logo_Transparent.png" alt="Krause IT" class="header-logo-img" height="36" />
        </a>

        <button
          type="button"
          id="nav-toggle"
          class="nav-toggle-button"
          aria-label="Open navigation menu"
          aria-controls="primary-navigation"
          aria-expanded="false"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>

        <button type="button" class="nav-overlay" aria-label="Close navigation menu"></button>

        <nav id="primary-navigation" aria-label="Primary navigation">
          <ul class="nav-links">
            <li><a href="#consulting" class="nav-link">Consulting</a></li>
            <li><a href="#web-services" class="nav-link">Web Services</a></li>
            <li><a href="#approach" class="nav-link">Approach</a></li>
            <li><a href="#contact" class="nav-link">Contact</a></li>
          </ul>
          <a href="#contact" class="btn btn-primary btn-sm header-cta-mobile">Discuss your project</a>
        </nav>

        <a href="#contact" class="btn btn-primary header-cta">Discuss your project</a>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer>
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <div class="footer-logo">
              <img src="/KrauseIT_Logo_Transparent.png" alt="Krause IT" class="footer-logo-img" height="36" />
            </div>
            <p>Delivering complex IT infrastructure, network, and systems change for schools and businesses across Australia.</p>
          </div>
          <div class="footer-links">
            <div class="footer-link-group">
              <h4>Services</h4>
              <ul class="footer-link-list">
                <li><a href="#consulting" class="footer-link">Consulting</a></li>
                <li><a href="#web-services" class="footer-link">Web Hosting & Design</a></li>
              </ul>
            </div>
            <div class="footer-link-group">
              <h4>Company</h4>
              <ul class="footer-link-list">
                <li><a href="#approach" class="footer-link">Our Approach</a></li>
                <li><a href="#contact" class="footer-link">Contact</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <p class="footer-geo">Australia-wide remote support. On-site across Perth and the South West.</p>
          <p>&copy; {new Date().getFullYear()} Krause IT. All rights reserved.</p>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('#nav-toggle');
      const navigation = document.querySelector('#primary-navigation');
      const overlay = document.querySelector('.nav-overlay');
      const mobileMenu = window.matchMedia('(max-width: 767px)');

      const setNavigationState = (isOpen) => {
        document.body.classList.toggle('nav-open', isOpen);
        toggle?.setAttribute('aria-expanded', String(isOpen));
        toggle?.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');

        if (navigation instanceof HTMLElement) {
          navigation.toggleAttribute('inert', mobileMenu.matches && !isOpen);
        }
      };

      const closeNavigation = () => setNavigationState(false);

      toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        setNavigationState(!isOpen);
      });

      overlay?.addEventListener('click', closeNavigation);
      navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNavigation));
      mobileMenu.addEventListener('change', closeNavigation);

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && document.body.classList.contains('nav-open')) {
          closeNavigation();
          toggle?.focus();
        }
      });

      setNavigationState(false);
    </script>
  </body>
</html>
