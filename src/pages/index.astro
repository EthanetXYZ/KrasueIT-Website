---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('case-studies')).filter((study) => !study.data.draft);
---

<Layout 
  title="Krause IT — Strategic IT Consulting & Infrastructure Change"
  description="Perth-based IT consultancy delivering complex systems, network, and infrastructure change for schools and businesses across Australia."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="badge badge-brand">IT Consulting & Projects</span>
        <h1>IT change, done properly.</h1>
        <p class="hero-subhead">
          Strategic IT consulting for schools and businesses navigating major technology change. Led by an experienced systems administrator providing remote advisory and implementation support Australia-wide, with on-site availability across Perth and the South West.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">Discuss your project</a>
          <a href="#approach" class="btn btn-secondary">See how we work</a>
        </div>
      </div>
      <div class="hero-graphics" aria-hidden="true">
        <!-- Abstract network/grid design representing infrastructure and systems change -->
        <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="hero-svg">
          <defs>
            <linearGradient id="gradient-accent" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="var(--color-brand)" />
              <stop offset="100%" stop-color="hsl(222, 100%, 75%)" />
            </linearGradient>
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(15, 23, 42, 0.04)" stroke-width="1"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid)" />
          <circle cx="200" cy="200" r="120" stroke="url(#gradient-accent)" stroke-width="2" stroke-dasharray="4 8" />
          <circle cx="200" cy="200" r="80" stroke="rgba(37, 99, 235, 0.15)" stroke-width="1.5" />
          <circle cx="200" cy="200" r="40" fill="rgba(37, 99, 235, 0.05)" />
          
          <!-- Node Connections -->
          <circle cx="200" cy="80" r="6" fill="var(--color-brand)" />
          <circle cx="290" cy="140" r="5" fill="var(--color-brand)" />
          <circle cx="270" cy="280" r="7" fill="var(--color-brand)" />
          <circle cx="110" cy="260" r="5" fill="var(--color-brand)" />
          <circle cx="130" cy="120" r="6" fill="var(--color-brand)" />
          
          <line x1="200" y1="80" x2="290" y2="140" stroke="var(--color-brand)" stroke-width="1" opacity="0.4" />
          <line x1="290" y1="140" x2="270" y2="280" stroke="var(--color-brand)" stroke-width="1" opacity="0.4" />
          <line x1="270" y1="280" x2="110" y2="260" stroke="var(--color-brand)" stroke-width="1" opacity="0.4" />
          <line x1="110" y1="260" x2="130" y2="120" stroke="var(--color-brand)" stroke-width="1" opacity="0.4" />
          <line x1="130" y1="120" x2="200" y2="80" stroke="var(--color-brand)" stroke-width="1" opacity="0.4" />

          <!-- Center connection -->
          <line x1="200" y1="200" x2="200" y2="80" stroke="var(--color-brand)" stroke-width="1.5" opacity="0.6" />
          <line x1="200" y1="200" x2="270" y2="280" stroke="var(--color-brand)" stroke-width="1.5" opacity="0.6" />
          <circle cx="200" cy="200" r="8" fill="var(--color-brand)" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Who This Is For Section -->
  <section class="section who-for-section">
    <div class="container">
      <div class="audience-layout">
        <div class="audience-intro">
          <span class="badge badge-brand">Partnership</span>
          <h2>For teams where IT decisions affect day-to-day operations.</h2>
          <p class="section-intro">We work with organisations that need practical technical leadership, not generic support tickets or abstract strategy documents.</p>
        </div>

        <div class="who-grid">
          <!-- Schools -->
          <div class="card who-card">
            <div class="card-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/></svg>
            </div>
            <h3>Schools</h3>
            <p>Modernisation backed by real-world experience inside education environments, with awareness of budgets, procurement, compliance, and classroom continuity.</p>
          </div>

          <!-- Businesses -->
          <div class="card who-card">
            <div class="card-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <h3>Growing Businesses</h3>
            <p>Support for businesses making technology decisions that affect efficiency, security, service reliability, and future growth.</p>
          </div>

          <!-- IT Teams -->
          <div class="card who-card">
            <div class="card-icon-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>IT Teams & Sysadmins</h3>
            <p>Additional senior capability for projects that need focused planning, implementation support, and practical delivery momentum.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Consulting Services (Primary) -->
  <section id="consulting" class="section services-section">
    <div class="container">
      <div class="services-layout">
        <div class="services-heading">
          <span class="badge badge-brand">Primary Services</span>
          <h2>Strategic IT Consulting</h2>
          <p class="section-intro">Practical technology advice and hands-on technical leadership to help organisations plan, modernise, and implement reliable systems.</p>
        </div>

        <div>
          <div class="services-grid">
            <!-- Service 1 -->
            <div class="service-item">
              <div class="service-icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
              </div>
              <div class="service-content">
                <h3>Infrastructure & Network Overhauls</h3>
                <p>Assessing, designing, and improving core IT infrastructure, from network architecture and connectivity through to server environments, wireless platforms, and operational systems.</p>
              </div>
            </div>

            <!-- Service 2 -->
            <div class="service-item">
              <div class="service-icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div class="service-content">
                <h3>Platform & System Migrations</h3>
                <p>Leading complex technology transitions from planning and preparation through to migration, validation, and handover.</p>
              </div>
            </div>

            <!-- Service 3 -->
            <div class="service-item">
              <div class="service-icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              </div>
              <div class="service-content">
                <h3>Systems & Vendor Review</h3>
                <p>Reviewing existing technology environments and vendor relationships to identify risks, inefficiencies, and opportunities to improve reliability, security, and value.</p>
              </div>
            </div>

            <!-- Service 4 -->
            <div class="service-item">
              <div class="service-icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div class="service-content">
                <h3>Project Delivery</h3>
                <p>Taking ownership of technical projects from planning through to implementation, including stakeholder coordination, change windows, and delivery follow-through.</p>
              </div>
            </div>
          </div>

          <div class="services-cta-banner">
            <div class="services-cta-content">
              <h3>Planning a significant IT change?</h3>
              <p>Start with a free 30-minute conversation about your current environment, intended outcome, and the best way forward.</p>
            </div>
            <a href="#contact" class="btn btn-primary">Start a conversation</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Web Hosting & Development (Secondary) -->
  <section id="web-services" class="section web-services-section">
    <div class="container">
      <div class="web-services-panel">
        <div class="web-services-intro">
          <span class="badge badge-brand">Web Services</span>
          <h2>Web Hosting & Design</h2>
          <p>
            Strategic IT consulting is our primary focus, but we also design, build, and host reliable websites for clients who want a practical, well-supported web presence.
          </p>
        </div>
        
        <div class="web-services-grid">
          <div class="web-service-card">
            <h4>Web Hosting</h4>
            <p>Hosted on high-speed Australian-based servers, with a free SSL certificate included.</p>
          </div>
          <div class="web-service-card">
            <h4>Web Design & Development</h4>
            <p>Custom-built business websites designed for fast loading, mobile usability, and accessibility.</p>
          </div>
          <div class="web-service-card">
            <h4>Domain Management</h4>
            <p>Secure management of domain registration, DNS configuration, and renewals to prevent expiry or service disruption.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Krause IT Section (Credibility) -->
  <section class="section why-section">
    <div class="container">
      <div class="why-panel">
        <div class="why-heading">
          <span class="badge badge-brand">Why Krause IT</span>
          <h2>Practical guidance from someone who also does the work.</h2>
          <p class="section-intro">Krause IT keeps advice close to implementation. You get clear technical direction, realistic planning, and hands-on delivery grounded in active school and business environments.</p>
        </div>

        <div class="why-points">
          <div class="why-point">
            <span class="why-point-marker">01</span>
            <div>
              <h3>Built around real constraints</h3>
              <p>Recommendations account for budget, procurement, compliance, timing, and the people who need systems to keep working.</p>
            </div>
          </div>
          <div class="why-point">
            <span class="why-point-marker">02</span>
            <div>
              <h3>Clear decisions, not vague reports</h3>
              <p>Technical risks, vendor options, and project trade-offs are translated into plain choices that leadership and IT teams can act on.</p>
            </div>
          </div>
          <div class="why-point">
            <span class="why-point-marker">03</span>
            <div>
              <h3>Planning connected to delivery</h3>
              <p>The person shaping the approach understands implementation detail, so plans stay grounded through assessment, migration, cutover, and validation.</p>
            </div>
          </div>
          <div class="why-point">
            <span class="why-point-marker">04</span>
            <div>
              <h3>Local when it matters</h3>
              <p>Remote support is available Australia-wide, with on-site assessments, stakeholder conversations, and deployment support available across Perth and the South West.</p>
            </div>
          </div>
        </div>

        <div class="why-note">
          <span>Led by Ethan Krause</span>
          <p>Experience across systems administration, education-sector operations, infrastructure modernisation, cloud transitions, and practical project delivery for organisations across Australia.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How We Work Section (Approach) -->
  <section id="approach" class="section approach-section">
    <div class="container">
      <div class="approach-panel">
        <div class="approach-heading">
          <span class="badge badge-brand">Our Approach</span>
          <h2>How we work</h2>
          <p class="section-intro">A clear sequence for turning uncertainty into a practical plan, then moving through delivery with minimal disruption.</p>
        </div>

        <div class="approach-steps">
          <div class="approach-step">
            <span class="approach-step-marker">1</span>
            <div>
              <h3>Initial conversation</h3>
              <p>Understand the challenge, current environment, operational requirements, decision-makers, and intended outcome.</p>
            </div>
          </div>

          <div class="approach-step">
            <span class="approach-step-marker">2</span>
            <div>
              <h3>Technical assessment</h3>
              <p>Review the relevant systems, infrastructure, vendors, risks, and constraints to establish the current position.</p>
            </div>
          </div>

          <div class="approach-step">
            <span class="approach-step-marker">3</span>
            <div>
              <h3>Plan and proposal</h3>
              <p>Develop a practical scope of work, implementation approach, schedule, and clear pricing before work starts.</p>
            </div>
          </div>

          <div class="approach-step">
            <span class="approach-step-marker">4</span>
            <div>
              <h3>Hands-on delivery</h3>
              <p>Complete the technical work, coordinate stakeholders, manage change windows, and communicate progress through to completion.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Studies Section -->
  {caseStudies.length > 0 && (
    <section class="section case-studies-section">
      <div class="container">
        <div class="section-header">
          <span class="badge badge-brand">Proven Results</span>
          <h2>Projects in the field</h2>
          <p class="section-intro">A look at how we resolve network, infrastructure, and systems transitions for local organisations.</p>
        </div>

        <div class="case-studies-list">
          {caseStudies.map((study) => (
            <article class="case-study-item">
              <div class="case-study-meta">
                <span class="case-study-sector">{study.data.sector}</span>
                <h3>{study.data.title}</h3>
                <p class="case-study-client">Client: {study.data.client} ({study.data.date})</p>
                <p class="case-study-summary">{study.data.summary}</p>
              </div>
              <div class="case-study-details">
                <div class="detail-block">
                  <h5>The Challenge</h5>
                  <p>{study.data.challenge}</p>
                </div>
                <div class="detail-block">
                  <h5>Our Approach</h5>
                  <p>{study.data.approach}</p>
                </div>
                <div class="detail-block">
                  <h5>The Outcome</h5>
                  <p>{study.data.outcome}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}


  <!-- Contact Section -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-panel">
        <div class="contact-info">
          <span class="badge badge-brand">Contact</span>
          <h2>Let's talk about your project.</h2>
          <p>
            Tell us what needs to change, what is getting in the way, and what a successful outcome looks like. We support remote consulting and project work Australia-wide, with on-site delivery available across Perth and the South West.
          </p>
          
          <div class="contact-details-box">
            <div class="contact-detail-row">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Australia-wide remote support</span>
            </div>
            <div class="contact-detail-row">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01"/><path d="M9 12v.01"/><path d="M9 15v.01"/><path d="M9 18v.01"/></svg>
              <span>On-site across Perth & South West WA</span>
            </div>
            <div class="contact-detail-row">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <a href="mailto:hello@krauseit.com.au">hello@krauseit.com.au</a>
            </div>
          </div>
        </div>

        <div class="contact-form-wrapper">
          <div class="contact-form-intro">
            <h3>Start with the essentials</h3>
            <p>A few details are enough. We can clarify scope, access, timing, and delivery model in the first conversation.</p>
          </div>

          <form name="contact-form" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact-form">
            <!-- Hidden input for Netlify forms -->
            <input type="hidden" name="form-name" value="contact-form" />
            <p class="sr-only">
              <label>Do not fill this out if you are human: <input name="bot-field" /></label>
            </p>

            <div class="form-row">
              <div class="form-group">
                <label for="name" class="form-label">Name</label>
                <input type="text" id="name" name="name" autocomplete="name" required class="form-control" placeholder="Who should we contact?" />
              </div>
              <div class="form-group">
                <label for="email" class="form-label">Email address</label>
                <input type="email" id="email" name="email" autocomplete="email" required class="form-control" placeholder="name@organisation.com.au" />
              </div>
            </div>

            <div class="form-group">
              <label for="org-type" class="form-label">Organisation</label>
              <select id="org-type" name="org-type" required class="form-control">
                <option value="" disabled selected>What best describes you?</option>
                <option value="School">School / Educational Institution</option>
                <option value="Business">Business / Commercial Organisation</option>
                <option value="IT Team">IT Team / Internal Technology Team</option>
                <option value="Other">Other Organisation</option>
              </select>
            </div>

            <div class="form-group">
              <label for="changing" class="form-label">What needs attention?</label>
              <textarea id="changing" name="changing" required class="form-control" rows="5" placeholder="Briefly describe the project, problem, or decision you are working through. Include location if on-site work may be needed."></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Send project details</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Section Header Styles */
  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto var(--spacing-xl) auto;
  }

  .section-header h2 {
    margin-top: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }

  .section-intro {
    font-size: 1.15rem;
  }

  /* bg colors */
  .bg-alt {
    background-color: var(--color-bg-alt);
  }

  @media (min-width: 768px) {
    .who-for-section,
    .services-section,
    .web-services-section,
    .why-section,
    .approach-section,
    .contact-section {
      padding-top: var(--spacing-xl);
      padding-bottom: var(--spacing-xl);
    }
  }

  /* Hero Section styles */
  .hero-section {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
    overflow: hidden;
    background: radial-gradient(circle at 85% 20%, rgba(37, 99, 235, 0.04) 0%, transparent 60%);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-content h1 {
    margin-top: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
    color: var(--color-bg-dark);
  }

  .hero-subhead {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: var(--spacing-lg);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .hero-svg {
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    display: block;
  }

  @media (min-width: 992px) {
    .hero-section {
      padding-top: var(--spacing-xxl);
      padding-bottom: var(--spacing-xxl);
    }
    .hero-container {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  /* Who This Is For styles */
  .who-for-section {
    background-color: var(--color-bg-alt);
  }

  .audience-layout {
    display: block;
  }

  .audience-intro {
    max-width: 660px;
    margin: 0 auto var(--spacing-xl);
    text-align: center;
  }

  .audience-intro h2 {
    margin-top: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }

  .who-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  @media (min-width: 768px) {
    .who-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 992px) {
    .who-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .who-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: var(--shadow-sm);
  }

  .card-icon-wrapper {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-md);
    background-color: var(--color-brand-light);
    color: var(--color-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--spacing-md);
  }

  .card-icon {
    width: 1.75rem;
    height: 1.75rem;
  }

  .who-card h3 {
    margin-bottom: var(--spacing-xs);
    font-size: 1.35rem;
  }

  /* Services Grid styles */
  .services-layout {
    display: block;
  }

  .services-heading {
    max-width: 680px;
    margin: 0 auto var(--spacing-xl);
    text-align: center;
  }

  .services-heading h2 {
    margin-top: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-main);
