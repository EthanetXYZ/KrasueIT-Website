<script>
  const picker = document.querySelector<HTMLElement>('[data-picker]');
  const estimateEl = document.querySelector<HTMLElement>('[data-picker-estimate]');
  const detailEl = document.querySelector<HTMLElement>('[data-picker-detail]');
  const continueBtn = document.querySelector<HTMLAnchorElement>('[data-picker-continue]');
  const selectionsBox = document.querySelector<HTMLElement>('[data-selections]');
  const selectionsList = document.querySelector<HTMLUListElement>('[data-selections-list]');
  const selectionsInput = document.querySelector<HTMLInputElement>('[data-selections-input]');
  const needSelect = document.querySelector<HTMLSelectElement>('#need');

  const money = (n: number) => `$${n.toLocaleString('en-AU')}`;
  const checked = (name: string) =>
    Array.from(picker?.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`) ?? []);

  const describe = (input: HTMLInputElement) => {
    const amount = Number(input.dataset.amount);
    if (!amount) return input.dataset.label ?? input.value;
    return `${input.dataset.label} (from ${money(amount)}${input.hasAttribute('data-monthly') ? '/month' : ''})`;
  };

  const update = () => {
    const [site] = checked('pick-site');
    const [plan] = checked('pick-plan');
    const extras = checked('pick-extra');

    const oneOff = Number(site?.dataset.amount) || 0;
    const monthly = Number(plan?.dataset.amount) || 0;
    const anything = Boolean(site || plan || extras.length);

    // Estimate line
    const parts = [oneOff && `${money(oneOff)} one-off`, monthly && `${money(monthly)}/month`].filter(Boolean);
    if (estimateEl) {
      estimateEl.textContent = parts.length
        ? `Estimate: from ${parts.join(' + ')}`
        : anything
          ? "We'll recommend the right options"
          : 'Choose your options to see an estimate';
    }

    const lines = [
      site && `Website: ${describe(site)}`,
      plan && `Ongoing: ${describe(plan)}`,
      extras.length > 0 && `Extras: ${extras.map((e) => e.dataset.label).join(', ')}`,
    ].filter((line): line is string => Boolean(line));

    if (detailEl) {
      detailEl.textContent = extras.some((e) => e.value !== 'unsure')
        ? 'Extras are quoted separately. Prices in AUD.'
        : 'Prices in AUD. Every quote is confirmed before work starts.';
    }

    // Carry selections into the contact form
    if (selectionsInput) selectionsInput.value = lines.join('\n');
    if (selectionsList) {
      selectionsList.replaceChildren(
        ...lines.map((line) => {
          const li = document.createElement('li');
          li.textContent = line;
          return li;
        }),
      );
    }
    if (selectionsBox) selectionsBox.hidden = lines.length === 0;
  };

  picker?.addEventListener('change', (event) => {
    const target = event.target;
    if (target instanceof HTMLInputElement && target.name === 'pick-extra' && target.checked) {
      // "I don't know" and specific extras are mutually exclusive
      const exclusive = target.hasAttribute('data-exclusive');
      checked('pick-extra').forEach((input) => {
        if (input !== target && input.hasAttribute('data-exclusive') !== exclusive) input.checked = false;
      });
    }
    update();
  });

  continueBtn?.addEventListener('click', () => {
    update();
    const [site] = checked('pick-site');
    const [plan] = checked('pick-plan');
    if (needSelect && !needSelect.value) {
      if (site) needSelect.value = 'New website';
      else if (plan && plan.value !== 'none') needSelect.value = 'Hosting, domain or email';
    }
    // Let the anchor scroll to the form, then put the cursor in the first empty field
    window.setTimeout(() => {
      const firstEmpty = Array.from(
        document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('#contact .form-control[required]'),
      ).find((field) => !field.value);
      firstEmpty?.focus({ preventScroll: true });
    }, 400);
  });

  update();
</script>
