---
import Layout from '../layouts/Layout.astro';

// ── Edit prices here ─────────────────────────────────────────────
// All prices are AUD "from" prices; they feed the packages section and structured data.
const pricing = {
  starter: 750,   // one-page site
  business: 1500, // up to 5 pages
  hosting: 30,    // per month, required
  care: 60,       // per month, optional (includes hosting)
};
// ─────────────────────────────────────────────────────────────────

const fmt = (n: number) => `$${n.toLocaleString('en-AU')}`;

const work = [
  {
    name: 'Dana Krause Sleep Coaching',
    sector: 'Sole trader · Coaching',
    blurb: 'A calm, warm site for a sleep coach supporting families with children aged 0–4, built around booking a free consult.',
    url: 'https://danakrause.com',
    image: '/work/danakrause.com.webp',
  },
  {
    name: 'Team McQueen — Car 95',
    sector: 'Charity · Variety WA Bash',
    blurb: 'A bold fundraising site for a Variety WA Bash team, with donations, sponsorship and the story of the car.',
    url: 'https://bashcar95.org',
    image: '/work/bashcar95.org.webp',
  },
  {
    name: 'On Point Events',
    sector: 'Events · MC services',
    blurb: 'A professional single-page site for an events business and MC.',
    url: null,
    image: null,
  },
  {
    name: 'Courtney Turner Remedial Massage',
    sector: 'Health · Aveley, WA',
    blurb: 'A booking-focused site for a home-clinic remedial massage therapist.',
    url: null,
    image: null,
  },
];

const builds = [
  {
    id: 'starter',
    amount: pricing.starter,
    name: 'Starter site',
    price: fmt(pricing.starter),
    unit: 'one-off',
    summary: 'A polished one-page website that tells people what you do and gets them in touch.',
    features: ['Single-page design', 'Mobile-friendly and fast', 'Contact or enquiry form', 'Basic SEO and Google-ready setup', 'Yours to keep, hosted wherever you like'],
  },
  {
    id: 'business',
    amount: pricing.business,
    name: 'Business site',
    price: fmt(pricing.business),
    unit: 'one-off',
    summary: 'Room to explain your services properly, with separate pages people can find on Google.',
    features: ['Up to 5 pages', 'Everything in Starter', 'Service, about and contact pages', 'Page-by-page SEO setup', 'Yours to keep, hosted wherever you like'],
    featured: true,
  },
];

const plans = [
  {
    id: 'hosting',
    amount: pricing.hosting,
    name: 'Hosting',
    price: fmt(pricing.hosting),
    unit: '/month',
    summary: 'Keeps your site online, secure and backed up, so you never have to think about it.',
    features: ['Australian-based hosting', 'Free SSL certificate', 'Daily backups', 'Uptime monitoring', 'Security and software updates', 'Domain and DNS management'],
  },
  {
    id: 'care',
    amount: pricing.care,
    name: 'Care plan',
    price: fmt(pricing.care),
    unit: '/month',
    summary: 'Hosting plus someone to make your changes for you.',
    features: ['Everything in Hosting', 'Up to 30 minutes of content changes each month', 'Priority support'],
  },
];

const extras = [
  { id: 'email', name: 'Business email', summary: 'Professional email like you@yourbusiness.com.au' },
  { id: 'domain', name: 'Domain registration', summary: 'Register a new .com.au or .com domain' },
  { id: 'dns', name: 'Connect my existing domain', summary: 'DNS set up for a domain you already own' },
  { id: 'migrate', name: 'Move my existing site', summary: 'Bring your current website across' },
  { id: 'pages', name: 'Extra pages', summary: 'More pages than your package includes' },
];

const offers = [
  { name: 'Starter site', description: 'One-page small business website', price: pricing.starter },
  { name: 'Business site', description: 'Small business website, up to 5 pages', price: pricing.business },
  { name: 'Hosting', description: 'Website hosting, SSL, backups, monitoring and security updates', price: pricing.hosting, unit: 'MON' as const },
  { name: 'Care plan', description: 'Hosting plus monthly content changes and priority support', price: pricing.care, unit: 'MON' as const },
];

const faqs = [
  {
    q: 'Who owns my website?',
    a: 'You do. Once your site is paid for, the website and its content belong to you, and your domain is yours too. If you ever want to move to another host or developer, you get everything you need to take it with you. No lock-in contracts, no exit fees.',
  },
  {
    q: 'Do I have to host with Krause IT?',
    a: 'No. Hosting is optional. Most clients choose it because it keeps everything in one place, with backups, security updates and monitoring handled for them. If you would rather use your own hosting, your site can be set up there instead.',
  },
  {
    q: "What's the difference between Hosting and the Care plan?",
    a: 'Hosting keeps your site running and secure. The Care plan includes everything in Hosting, plus up to 30 minutes of content changes each month, such as new photos, updated prices or a new announcement, and priority support.',
  },
  {
    q: 'I already have a domain name. Can I keep it?',
    a: 'Yes. Your existing domain can be connected to your new site, or moved across so it is managed alongside your hosting and never accidentally expires.',
  },
  {
    q: 'Can you move or rebuild my existing website?',
    a: 'Yes. Moving an existing site is available as an add-on, and a rebuild is quoted the same way as a new site. Tell us what you have now in the form below.',
  },
  {
    q: 'Do you only work with businesses in Perth?',
    a: 'No. Everything is done remotely, so it works the same wherever you are in Australia. Most of the process happens over email and a quick call or two.',
  },
  {
    q: 'What do I need to get started?',
    a: 'A rough idea of what you want people to know and do, plus your logo and any photos you have. Not sure what to write? That is fine. Help with wording is part of the process.',
  },
];
---

<Layout offers={offers}>
  <!-- Hero -->
  <section id="top" class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="badge badge-brand">Websites · Hosting · Domains</span>
        <h1>Your website, done properly.</h1>
        <p class="hero-subhead">
          Krause IT designs, builds and hosts websites for small businesses, sole traders and community groups. One person looks after your site, hosting and domain, backed by a systems administrator's know-how. You own your website, with no lock-in. Fully remote, Australia-wide.
        </p>
        <div class="hero-actions">
          <a href="#packages" class="btn btn-primary">See packages</a>
          <a href="#work" class="btn btn-secondary">View recent work</a>
        </div>
      </div>
      <div class="hero-graphics" aria-hidden="true">
        <div class="browser browser-back">
          <div class="browser-bar"><span></span><span></span><span></span></div>
          <img src={work[1].image} alt="" width="960" height="600" />
        </div>
        <div class="browser browser-front">
          <div class="browser-bar"><span></span><span></span><span></span></div>
          <img src={work[0].image} alt="" width="960" height="600" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section who-for-section">
    <div class="container">
      <div class="audience-intro">
        <span class="badge badge-brand">Who it's for</span>
        <h2>For people who'd rather run their business than wrestle with a website.</h2>
        <p class="section-intro">You get a site that looks the part and brings in enquiries, and someone who handles the technical side for you.</p>
      </div>
      <div class="who-grid">
        <div class="card who-card">
          <div class="card-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg>
          </div>
          <h3>Sole traders & professionals</h3>
          <p>Coaches, therapists, consultants and event professionals who need a site that builds trust and makes booking easy.</p>
        </div>
        <div class="card who-card">
          <div class="card-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon" aria-hidden="true"><path d="M3 9l1-5h16l1 5"/><path d="M4 9v11h16V9"/><path d="M9 20v-6h6v6"/></svg>
          </div>
          <h3>Small local businesses</h3>
          <p>Local services and small teams who want a professional web presence without paying agency prices.</p>
        </div>
        <div class="card who-card">
          <div class="card-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="card-icon" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          </div>
          <h3>Charities & community groups</h3>
          <p>Clubs, fundraising teams and not-for-profits that need to share their story and make it easy to donate or get involved.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent work -->
  <section id="work" class="section work-section">
    <div class="container">
      <div class="section-heading">
        <span class="badge badge-brand">Recent work</span>
        <h2>Sites built for real clients</h2>
        <p class="section-intro">A few recent projects for sole traders, small businesses and a charity team.</p>
      </div>
      <div class="work-grid">
        {work.map((item) => (
          <article class:list={['work-card', { 'work-card-soon': !item.url }]}>
            {item.image ? (
              <a href={item.url} class="work-thumb" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <img src={item.image} alt="" width="960" height="600" loading="lazy" />
              </a>
            ) : (
              <div class="work-thumb work-thumb-placeholder" aria-hidden="true">
                <span>Launching soon</span>
              </div>
            )}
            <div class="work-body">
              <span class="work-sector">{item.sector}</span>
              <h3>{item.name}</h3>
              <p>{item.blurb}</p>
              {item.url ? (
                <a href={item.url} class="work-link" target="_blank" rel="noopener">
                  Visit {item.url.replace('https://', '')}<span class="sr-only"> (opens in a new tab)</span> →
                </a>
              ) : (
                <span class="work-link work-link-muted">Launching soon</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Packages -->
  <section id="packages" class="section packages-section">
    <div class="container">
      <div class="section-heading">
        <span class="badge badge-brand">Packages</span>
        <h2>Build your quote</h2>
        <p class="section-intro">Pick a website, an optional monthly plan and any extras. Not sure? Choose "I don't know" and we'll recommend what fits. The site is yours either way.</p>
      </div>

      <div class="picker" data-picker>
        <fieldset class="picker-step">
          <legend class="package-group-title">1. Choose your website</legend>
          <div class="package-grid">
            {builds.map((pkg) => (
              <label class:list={['package-card', 'option-card', { 'package-card-featured': pkg.featured }]}>
                <input type="radio" name="pick-site" value={pkg.id} class="option-input" data-label={pkg.name} data-amount={pkg.amount} />
                <span class="option-check" aria-hidden="true"></span>
                <span class="package-name">{pkg.name}</span>
                <span class="package-price"><span class="package-from">from</span> {pkg.price} <span class="package-unit">{pkg.unit}</span></span>
                <span class="package-summary">{pkg.summary}</span>
                <ul class="package-features">
                  {pkg.features.map((f) => <li>{f}</li>)}
                </ul>
              </label>
            ))}
          </div>
          <div class="option-row">
            <label class="option-chip">
              <input type="radio" name="pick-site" value="unsure" class="option-input" data-label="I don't know yet" />
              <span class="option-check" aria-hidden="true"></span>
              <span><strong>I don't know</strong> <span class="option-chip-note">Tell us about your business and we'll recommend the right fit.</span></span>
            </label>
          </div>
        </fieldset>

        <fieldset class="picker-step">
          <legend class="package-group-title">2. Keep it running <span class="package-group-note">(optional)</span></legend>
          <div class="package-grid">
            {plans.map((plan) => (
              <label class="package-card option-card">
                <input type="radio" name="pick-plan" value={plan.id} class="option-input" data-label={plan.name} data-amount={plan.amount} data-monthly />
                <span class="option-check" aria-hidden="true"></span>
                <span class="package-name">{plan.name}</span>
                <span class="package-price"><span class="package-from">from</span> {plan.price}<span class="package-unit">{plan.unit}</span></span>
                <span class="package-summary">{plan.summary}</span>
                <ul class="package-features">
                  {plan.features.map((f) => <li>{f}</li>)}
                </ul>
              </label>
            ))}
          </div>
          <div class="option-row">
            <label class="option-chip">
              <input type="radio" name="pick-plan" value="none" class="option-input" data-label="No thanks, I'll host it myself" />
              <span class="option-check" aria-hidden="true"></span>
              <span><strong>No thanks</strong> <span class="option-chip-note">I'll host it myself.</span></span>
            </label>
            <label class="option-chip">
              <input type="radio" name="pick-plan" value="unsure" class="option-input" data-label="I don't know yet" />
              <span class="option-check" aria-hidden="true"></span>
              <span><strong>I don't know</strong> <span class="option-chip-note">Help me decide.</span></span>
            </label>
          </div>
        </fieldset>

        <fieldset class="picker-step">
          <legend class="package-group-title">3. Anything else? <span class="package-group-note">(tick any, quoted separately)</span></legend>
          <div class="extras-grid">
            {extras.map((extra) => (
              <label class="option-chip option-chip-box">
                <input type="checkbox" name="pick-extra" value={extra.id} class="option-input" data-label={extra.name} />
                <span class="option-check option-check-box" aria-hidden="true"></span>
                <span><strong>{extra.name}</strong> <span class="option-chip-note">{extra.summary}</span></span>
              </label>
            ))}
            <label class="option-chip option-chip-box">
              <input type="checkbox" name="pick-extra" value="unsure" class="option-input" data-label="I don't know, please advise" data-exclusive />
              <span class="option-check option-check-box" aria-hidden="true"></span>
              <span><strong>I don't know</strong> <span class="option-chip-note">Not sure what else you need? We'll advise.</span></span>
            </label>
          </div>
        </fieldset>

        <div class="picker-summary">
          <div class="picker-summary-text" aria-live="polite">
            <span class="picker-estimate" data-picker-estimate>Choose your options to see an estimate</span>
            <span class="picker-detail" data-picker-detail>Prices in AUD. Every quote is confirmed before work starts.</span>
          </div>
          <a href="#contact" class="btn btn-primary" data-picker-continue>Continue →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="process" class="section approach-section">
    <div class="container">
      <div class="section-heading">
        <span class="badge badge-brand">How it works</span>
        <h2>From first chat to live site</h2>
        <p class="section-intro">A simple process that keeps you in the loop without eating up your time.</p>
      </div>
      <ol class="approach-steps">
        <li class="approach-step">
          <span class="approach-step-marker">1</span>
          <div>
            <h3>Quick chat</h3>
            <p>Tell us about your business, who you want to reach and what you need. You'll get a clear quote before anything starts.</p>
          </div>
        </li>
        <li class="approach-step">
          <span class="approach-step-marker">2</span>
          <div>
            <h3>Design & build</h3>
            <p>Your site is designed and built around your content, with help on wording and layout where you need it.</p>
          </div>
        </li>
        <li class="approach-step">
          <span class="approach-step-marker">3</span>
          <div>
            <h3>Review & launch</h3>
            <p>You review the site and request changes. Once you're happy, it goes live on your domain.</p>
          </div>
        </li>
        <li class="approach-step">
          <span class="approach-step-marker">4</span>
          <div>
            <h3>Yours, and looked after</h3>
            <p>The site is yours. Choose a Hosting or Care plan and the hosting, backups, updates and domain are handled from then on.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Why Krause IT -->
  <section id="why" class="section why-section">
    <div class="container">
      <div class="why-panel">
        <div class="why-heading">
          <span class="badge badge-brand">Why Krause IT</span>
          <h2>A web designer who also knows the tech underneath.</h2>
          <p class="section-intro">Plenty of people can make a website look good. Krause IT also gets the hosting, domains, DNS and security right, so your site keeps working long after launch.</p>
        </div>
        <div class="why-points">
          <div class="why-point">
            <span class="why-point-marker">01</span>
            <div>
              <h3>You own your website</h3>
              <p>Your site, content and domain belong to you. Hosting is optional and there are no lock-in contracts, so you stay because the service is good.</p>
            </div>
          </div>
          <div class="why-point">
            <span class="why-point-marker">02</span>
            <div>
              <h3>Fast, mobile-first sites</h3>
              <p>Built to load quickly and look great on phones, where most of your visitors will find you.</p>
            </div>
          </div>
          <div class="why-point">
            <span class="why-point-marker">03</span>
            <div>
              <h3>Security and backups handled</h3>
              <p>Updates, SSL, backups and uptime monitoring are part of every hosting plan, not optional extras.</p>
            </div>
          </div>
          <div class="why-point">
            <span class="why-point-marker">04</span>
            <div>
              <h3>One person, clear pricing</h3>
              <p>Website, hosting and domain handled by the same person, with a confirmed quote before work begins and no surprise invoices.</p>
            </div>
          </div>
        </div>
        <div class="why-note">
          <span>Run by Ethan Krause</span>
          <p>A systems administrator with over a decade of experience in IT, across schools and businesses, now building and hosting websites for small businesses and community groups across Australia.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section faq-section">
    <div class="container faq-container">
      <div class="section-heading">
        <span class="badge badge-brand">FAQ</span>
        <h2>Common questions</h2>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="contact-panel">
        <div class="contact-info">
          <span class="badge badge-brand">Contact</span>
          <h2>Let's get your website sorted.</h2>
          <p>Tell us a little about your business and what you need. You'll get a reply by email with next steps and a quote.</p>
          <div class="contact-details-box">
            <div class="contact-detail-row">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              <span>Fully remote, Australia-wide</span>
            </div>
            <div class="contact-detail-row">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <a href="mailto:hello@krauseit.com.au">hello@krauseit.com.au</a>
            </div>
          </div>
        </div>

        <div class="contact-form-wrapper">
          <div class="contact-form-intro">
            <h3>Start with the basics</h3>
            <p>A few details are enough. We'll work out the rest together.</p>
          </div>
          <form name="contact-form" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" class="contact-form">
            <input type="hidden" name="form-name" value="contact-form" />
            <p class="sr-only">
              <label>Do not fill this out if you are human: <input name="bot-field" /></label>
            </p>
            <input type="hidden" name="selections" value="" data-selections-input />

            <div class="form-selections" data-selections hidden>
              <div class="form-selections-head">
                <span class="form-label">Your selections</span>
                <a href="#packages">Change</a>
              </div>
              <ul data-selections-list></ul>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="name" class="form-label">Name</label>
                <input type="text" id="name" name="name" autocomplete="name" required class="form-control" placeholder="Your name" />
              </div>
              <div class="form-group">
                <label for="email" class="form-label">Email address</label>
                <input type="email" id="email" name="email" autocomplete="email" required class="form-control" placeholder="you@business.com.au" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="business" class="form-label">Business or organisation <span class="form-optional">(optional)</span></label>
                <input type="text" id="business" name="business" autocomplete="organization" class="form-control" placeholder="Business name" />
              </div>
              <div class="form-group">
                <label for="need" class="form-label">What do you need?</label>
                <select id="need" name="need" required class="form-control">
                  <option value="" disabled selected>Choose one</option>
                  <option value="New website">A new website</option>
                  <option value="Rebuild or move existing site">Rebuild or move my existing site</option>
                  <option value="Hosting, domain or email">Hosting, domain or email</option>
                  <option value="Something else">Something else</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Tell us a bit more</label>
              <textarea id="message" name="message" required class="form-control" rows="5" placeholder="What does your business do, and what should the website help with? Include your current website or domain if you have one."></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Send enquiry</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-intro {
    font-size: 1.15rem;
  }

  .section-heading,
  .audience-intro {
    max-width: 680px;
    margin: 0 auto var(--spacing-xl);
    text-align: center;
  }

  .section-heading h2,
  .audience-intro h2 {
    margin-top: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }

  /* Hero */
  .hero-section {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
    overflow: hidden;
    background: radial-gradient(circle at 85% 20%, rgba(37, 99, 235, 0.06) 0%, transparent 60%);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-content h1 {
    margin-top: var(--spacing-sm);
