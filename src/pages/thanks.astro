---
import Layout from '../layouts/Layout.astro';
import SimpleMessage from '../components/SimpleMessage.astro';
---

<Layout
  title="Thanks for getting in touch — Krause IT"
  description="Your project details have been sent to Krause IT."
  noindex
>
  <SimpleMessage eyebrow="Message sent" heading="Thanks, your details are on their way.">
    <p>We'll review what you've sent and get back to you by email. If it's urgent, email us directly.</p>
  </SimpleMessage>
</Layout>

<script is:inline>
  // Record a completed enquiry as a lead in Google Analytics (only runs when analytics is enabled)
  if (typeof window.gtag === 'function') window.gtag('event', 'generate_lead');
</script>
